# ipad-pm PWA — 빌드 시 환경변수 (Vite 의 VITE_ 접두사 필수)
#
# 1) Google Cloud Console 에서 OAuth Client ID 발급 (애플리케이션 유형: 웹)
#    Authorized JavaScript origins 에 다음을 등록:
#      - 개발: http://localhost:5174
#      - 운영: https://<your-username>.github.io  (또는 호스팅 도메인)
#
# 2) 본 파일을 .env.local 로 복사하고 값 채워넣기. .env.local 은 .gitignore 됨.
#
# 3) 운영 빌드 시 같은 환경변수를 GitHub Actions secrets 또는 빌드 명령 앞에 두면 됨:
#      VITE_GOOGLE_CLIENT_ID=... npm run build

VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com

# 정적 호스팅 base path (예: GitHub Pages 의 https://user.github.io/<repo>/ → /<repo>/)
# 로컬 dev 에서는 비우면 됨.
# VITE_BASE_PATH=/your-repo-name/
